APP_NAME=PayEase
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# === Production Override Checklist ===
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://yourdomain.com
# LOG_CHANNEL=stack
# LOG_STACK=daily
# LOG_LEVEL=warning
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_DATABASE=payease
# DB_USERNAME=deploy_user
# SESSION_DRIVER=redis
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=strict
# SESSION_ENCRYPT=true
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# BROADCAST_CONNECTION=log
#
# Trust proxies when behind a load balancer (e.g. Cloudflare, AWS ELB, Nginx).
# Use '*' to trust all proxies, or a comma-separated list of IPs.
# TRUSTED_PROXY_IPS=*
#
# Backups (configure AWS credentials above when using s3)
# BACKUP_DISK=s3
# BACKUP_RETENTION_DAYS=7
# BACKUP_PREFIX=backups/
#
# SMS failover: termii | africastalking | failover | log
# SMS_DRIVER=termii
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=
# AFRICASTALKING_ENVIRONMENT=sandbox
#
# Mail failover (comma-separated list of configured mailers)
# MAIL_MAILER=failover
# MAIL_FAILOVER_MAILERS=smtp,ses
# ===

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
